# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/govrouter

# Gemini LLM (get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Embeddings (uses Gemini embedding model; leave blank to reuse GEMINI_API_KEY)
EMBEDDING_API_KEY=
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIM=768

# Pipeline tuning
CONFIDENCE_THRESHOLD=0.75
RETRIEVAL_TOP_K=5

# Auth (Phase 3 — NextAuth)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Frontend → Backend
NEXT_PUBLIC_API_URL=http://localhost:8000
