# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/govrouter

# Gemini LLM — only needed for intent extraction + re-ranking (not embeddings)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Model name 
GEMINI_MODEL=gemini-3.5-flash

# Local embeddings (sentence-transformers — no API key required)
# Other good free options: BAAI/bge-small-en-v1.5 (also 384-dim)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Pipeline tuning
CONFIDENCE_THRESHOLD=0.75
FALLBACK_CONFIDENCE_THRESHOLD=0.60
RETRIEVAL_TOP_K=5

# Auth (NextAuth — shared secret with frontend)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set true only when seeding a disposable local database.
SEED_DEMO_USERS=false

# Frontend → Backend
NEXT_PUBLIC_API_URL=http://localhost:8000
